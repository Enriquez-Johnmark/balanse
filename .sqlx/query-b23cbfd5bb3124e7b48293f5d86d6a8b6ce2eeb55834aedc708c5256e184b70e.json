  "query": "select f.id, f.media_type, f.size_bytes, f.uploaded_at from claim_files f\n             join stored_files s on s.id = f.id and s.deleted_at is null\n             where f.tenant_id = $1 and f.claim_id = $2\n             order by f.uploaded_at, f.id",
